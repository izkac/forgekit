{
  "name": "forgekit",
  "version": "0.3.49",
  "private": true,
  "description": "Forgekit \u2014 portable agent skills monorepo (Forge workflow and more)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "forgekit": "node packages/cli/bin/forgekit.mjs",
    "forge": "node packages/cli/bin/forge.mjs",
    "review": "node packages/cli/bin/review.mjs",
    "test": "npm run test --workspace=@izkac/forgekit",
    "test:evals": "node --test evals/harbor/*.test.mjs",
    "lint": "eslint scripts evals && npm run lint --workspace=@izkac/forgekit",
    "lint:evals": "eslint evals",
    "smoke:evals": "node evals/harbor/smoke.mjs",
    "smoke:evals:hard-v2": "node evals/harbor/smoke-hard-v2.mjs",
    "smoke:evals:campaign": "node evals/harbor/smoke-campaign.mjs",
    "prepack": "npm run prepack --workspace=@izkac/forgekit",
    "install:link": "npm install && npm link --workspace=@izkac/forgekit"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
