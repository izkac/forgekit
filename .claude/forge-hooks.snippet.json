{
  "_comment": "Merge these hooks into .claude/settings.json (SessionStart + UserPromptSubmit + PreToolUse). Paths assume forge CLI is on PATH. The PreToolUse hook is inert until .forge/models.local.json exists.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/forge-session-start.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/forge-prompt-hook.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/forge-model-hook.mjs\"",
            "statusMessage": "Checking subagent model policy"
          }
        ]
      }
    ]
  }
}
