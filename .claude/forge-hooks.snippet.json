{
  "_comment": "Merge these hooks into .claude/settings.json (SessionStart + UserPromptSubmit + PreToolUse + Stop). Paths assume forge CLI is on PATH. The model-policy PreToolUse hook is inert until .forge/models.local.json exists; the test-guard PreToolUse hook is inert without an active Forge session in implement/verify/review/finish; the lease-guard PreToolUse hook is inert until .forge/config.json has a `leases` entry with `match` patterns; the Stop hook is inert without an active Forge session claiming completion.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/forge-session-start.mjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/forge-prompt-hook.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/forge-model-hook.mjs\"",
            "statusMessage": "Checking subagent model policy"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/forge-test-guard.mjs\"",
            "statusMessage": "Checking test-guard policy"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/forge-lease-guard.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/forge-stop-hook.mjs\""
          }
        ]
      }
    ]
  }
}
